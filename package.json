{
  "name": "@citolab/qti-api",
  "version": "9.3.0",
  "private": false,
  "type": "module",
  "description": "Shared TypeScript client and models for Citolab QTI backends (Firebase and .NET), with pluggable authentication.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "release": "np --no-tests",
    "release:patch": "np patch --no-tests",
    "release:minor": "np minor --no-tests",
    "release:major": "np major --no-tests"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "typescript",
    "library"
  ],
  "author": "Patrick de Klein, Sander Looise, Marcel Hoekstra",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/qti-api.git"
  },
  "bugs": {
    "url": "https://github.com/Citolab/qti-api/issues"
  },
  "homepage": "https://github.com/Citolab/qti-api#readme",
  "peerDependencies": {
    "@citolab/qti-components": "^8.0.1 || ^9.6.2 || ^10.0.0-next.0",
    "axios": ">=1.7.0"
  },
  "devDependencies": {
    "@citolab/qti-components": "^9.6.2",
    "@types/node": "^26.6.5",
    "np": "^12.1.1",
    "typescript": "^7.0.2"
  }
}
